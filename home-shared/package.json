{
  "name": "@home/shared",
  "version": "1.0.0",
  "description": "Types, Zod schemas, post Markdown rules and slug and image-name code shared by home-server and home-web-ui.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "./build/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "sh ../scripts/build-shared.sh --force",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "^7"
  }
}
