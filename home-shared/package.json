{
  "name": "@home/shared",
  "version": "1.0.0",
  "description": "HTTP contract types shared between home-server and its clients.",
  "license": "ISC",
  "private": true,
  "main": "./build/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "rimraf ./build && tsc",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7"
  }
}
