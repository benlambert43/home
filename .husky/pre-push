run() {
  label="$1"; shift
  printf '\n\033[1m▶ %s\033[0m\n' "$label"
  if ! "$@"; then
    printf '\n\033[31m✖ %s failed — push aborted.\033[0m\n' "$label"
    case "$label" in
      format:check) printf '  Fix with: \033[1mnpm run format\033[0m\n' ;;
      lint)         printf '  Fix with: \033[1mnpm run lint -- --fix\033[0m\n' ;;
    esac
    printf '  Bypass with: \033[1mgit push --no-verify\033[0m\n\n'
    exit 1
  fi
}

run format:check npm run format:check
run lint         npm run lint
run typecheck    npm run typecheck
run build        npm run build

printf '\n\033[32m✔ pre-push checks passed\033[0m\n\n'
