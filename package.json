{
  "name": "home",
  "version": "1.0.0",
  "description": "Ben Lambert's Personal Website",
  "license": "ISC",
  "private": true,
  "workspaces": [
    "home-shared",
    "home-server",
    "home-web-ui"
  ],
  "scripts": {
    "build:shared": "sh scripts/build-shared.sh",
    "dev": "npm run build:shared && npm run dev --workspace home-web-ui",
    "dev:server": "npm run build:shared && npm run dev --workspace home-server",
    "build": "npm run build --workspace home-shared && npm run build --workspace home-server && npm run build --workspace home-web-ui",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:deprecations": "sh scripts/check-deprecations.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "format": "sh scripts/format.sh --write",
    "format:check": "sh scripts/format.sh --check",
    "check": "sh scripts/check-full.sh",
    "clean": "sh scripts/clean.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
