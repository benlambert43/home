{
  "name": "home",
  "version": "1.0.0",
  "description": "Ben Lambert's Personal Website",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "workspaces": [
    "home-shared",
    "home-server",
    "home-web-ui"
  ],
  "scripts": {
    "build:shared": "sh scripts/build-shared.sh",
    "dev": "npm run build:shared && npm run dev --workspace home-web-ui",
    "dev:server": "npm run build:shared && npm run dev --workspace home-server",
    "build": "npm run build --workspace home-shared && npm run build --workspace home-server && npm run build --workspace home-web-ui",
    "seed": "npm run seed --workspace home-server",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:deprecations": "sh scripts/check-deprecations.sh",
    "lint:shell": "sh scripts/check-shell.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "sh scripts/format.sh --write",
    "format:check": "sh scripts/format.sh --check",
    "check": "sh scripts/check-full.sh",
    "smoke": "sh scripts/smoke-test.sh",
    "env:placeholders": "sh scripts/env-placeholders.sh",
    "revalidate": "sh scripts/revalidate-site.sh",
    "clean": "sh scripts/clean.sh",
    "rebuilddevenvironment": "npm run clean && npm install && docker compose -f docker-compose.dev.yml up -d && npm run seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
