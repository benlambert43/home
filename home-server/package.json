{
  "name": "home-server",
  "version": "1.0.0",
  "description": "Express + mongoose API.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "rimraf ./build && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env build/index.js",
    "seed": "sh ../scripts/build-shared.sh && tsx --env-file=.env src/scripts/seedPosts.ts",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "sh ../scripts/build-shared.sh && vitest run",
    "test:coverage": "sh ../scripts/build-shared.sh && vitest run --coverage"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@home/shared": "*",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "obscenity": "^0.4.6",
    "sharp": "^0.35.5",
    "unique-username-generator": "^1.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.0.3"
  }
}
