{
  "name": "home-server",
  "version": "1.0.0",
  "main": "build/index.js",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "tsx watch --env-file=.env src/index.ts",
    "start:prod": "npm run build && node --env-file=.env build/index.js",
    "build": "rimraf ./build && tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "test": "echo \"No tests yet.\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "",
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@home/shared": "*",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "nodemailer": "^9.0.5",
    "unique-username-generator": "^1.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6"
  }
}
